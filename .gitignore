# Keep this repository limited to runtime and release files.
/*

# Repository and release configuration.
!/.gitignore
/.bpn-work/
__pycache__/
*.pyc
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/release.yml
!/.github/workflows/scheduled-refresh.yml

# Automatic refresh implementation and verification inputs.
!/.codex/
/.codex/*
!/.codex/config.toml
!/AGENTS.md
!/requirements-dev.txt
!/automation/
!/automation/**
!/docs/
!/docs/**
!/skills/
/skills/*
!/skills/fetch-retail-patch-notes/
!/skills/fetch-retail-patch-notes/**
!/skills/translate-patch-notes/
!/skills/translate-patch-notes/**
!/tests/
!/tests/**
**/__pycache__/
*.pyc

# Public project documentation.
!/README.md
!/LICENSE
!/LICENSE.*

# Canonical patch-note source used by both products.
!/data/
/data/*
!/data/retail-patch-notes.json

# Public Vue website and Netlify configuration.
!/web-app/
!/web-app/**
/web-app/node_modules/
/web-app/dist/
/web-app/.netlify/
/web-app/src/generated/
!/netlify.toml

# Runtime addon package.
!/BetterPatchNotes.toc
!/Addon.lua
!/Localization.lua
!/PatchNotesData.lua
!/Data.lua
!/State.lua
!/Window.lua
!/MinimapButton.lua
!/Core.lua
!/changelog.txt
