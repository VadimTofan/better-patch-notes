{
  "name": "better-patch-notes-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "prepare:data": "node scripts/prepare-patch-notes.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite",
    "prebuild": "npm run prepare:data",
    "build": "npm run type-check && npm run build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "npm run test:data && vitest run",
    "test:data": "node --test scripts/*.test.mjs",
    "test:unit": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@tsconfig/node22": "22.0.5",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
